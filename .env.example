# RDCA website — Vercel environment variables (server-only; never exposed to the browser).
# Set these in Vercel → Project Settings → Environment Variables (Production; add Preview to test
# on the preview URL). Do NOT prefix with VITE_/NEXT_PUBLIC_ — they are read only by the
# serverless function in /api/contact.js, never bundled into client code.
#
# Copy to a local .env (gitignored) only if you run the function locally; production values live
# in Vercel, not in the repo.

# Zoho CPaaS / ZeptoMail "Send Mail" token.  Format: "Zoho-enczapikey XXXXXXXXXXXX"
# Where from: Zoho Mail Admin Console → ZeptoMail → Mail Agents → (your agent) → "Send Mail API" → token.
ZEPTO_TOKEN=

# Verified sender the email is sent FROM.  Use a verified SportsWeb domain initially
# (e.g. noreply@sportsweb.com.au); switch to noreply@rdca.com once rdca.com is verified in Zoho.
ZEPTO_FROM=

# Destination inbox for form notifications, e.g. admin@rdca.com
CONTACT_TO=

# Optional display name for the destination inbox, e.g. "RDCA"
CONTACT_TO_NAME=

# ZeptoMail API endpoint for YOUR account's region. This account is AU — set the AU endpoint
# exactly as shown in the Zoho ZeptoMail console. Leaving this blank uses the GLOBAL default
# (https://api.zeptomail.com/v1.1/email), which will fail for an AU-region account.
#   AU: https://api.zeptomail.com.au/v1.1/email
ZEPTO_API=
